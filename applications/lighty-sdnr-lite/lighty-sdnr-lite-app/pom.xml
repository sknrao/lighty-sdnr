<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
        <modelVersion>4.0.0</modelVersion>
        <parent>
        <groupId>io.lighty.core</groupId>
        <artifactId>lighty-app-parent</artifactId>
        <version>23.0.0</version>
        <relativePath/>
    </parent>
        <groupId>org.iosmcn.lighty.sdnr</groupId>
        <artifactId>lighty-sdnr-lite-app</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <packaging>jar</packaging>
        <name>${project.groupId}:${project.artifactId}</name>
        <url>https://github.com/PANTHEONtech/lighty</url>
        <properties>
                <application.main.class>org.iosmcn.lighty.sdnr.lite.app.Main</application.main.class>
                <application.attach.zip>true</application.attach.zip>
                <maven.deploy.skip>true</maven.deploy.skip>
                <!-- O-RAN NETCONF 2013 revision support from netconf-10.0.x -->
                <netconf.oran.version>10.0.4-SNAPSHOT</netconf.oran.version>
        </properties>

        <dependencies>
                <!-- 
                     O-RAN NETCONF Support (from netconf-10.0.x with fixes):
                     1. rfc6241 model with ietf-netconf@2013-09-29 revision
                     2. netconf-client-mdsal with transformer fix for base RPC parsing
                -->
                
                <!-- Custom rfc6241 with 2013-09-29 revision for O-RAN compatibility -->
                <dependency>
                        <groupId>org.opendaylight.netconf.model</groupId>
                        <artifactId>rfc6241</artifactId>
                        <version>${netconf.oran.version}</version>
                        <exclusions>
                                <exclusion>
                                        <groupId>org.opendaylight.ietf.model</groupId>
                                        <artifactId>rfc6241</artifactId>
                                </exclusion>
                        </exclusions>
                </dependency>
                
                <!-- Keep ietf.model:rfc6241 for rev110601 classes needed by netconf-node-topology -->
                <dependency>
                        <groupId>org.opendaylight.ietf.model</groupId>
                        <artifactId>rfc6241</artifactId>
                </dependency>
                
                <!-- Patched netconf-client-mdsal with transformer fix - MUST come BEFORE lighty-netconf-sb -->
                <dependency>
                        <groupId>org.opendaylight.netconf</groupId>
                        <artifactId>netconf-client-mdsal</artifactId>
                        <version>${netconf.oran.version}</version>
                </dependency>
                
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-netconf-sb</artifactId>
                        <version>23.0.0</version>
                        <exclusions>
                                <exclusion>
                                        <groupId>org.opendaylight.ietf.model</groupId>
                                        <artifactId>rfc6241</artifactId>
                                </exclusion>
                                <!-- Exclude Lighty's netconf-client-mdsal, we use our patched version -->
                                <exclusion>
                                        <groupId>org.opendaylight.netconf</groupId>
                                        <artifactId>netconf-client-mdsal</artifactId>
                                </exclusion>
                        </exclusions>
                </dependency>
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-restconf-nb-community</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-openapi</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
            <groupId>org.iosmcn.lighty.applications</groupId>
            <artifactId>mountpoint-registrar</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.iosmcn.lighty.sdnr</groupId>
            <artifactId>yang-schema-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.iosmcn.lighty.sdnr</groupId>
            <artifactId>data-provider-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
                <dependency>
                        <groupId>io.lighty.applications</groupId>
                        <artifactId>lighty-app-modules-config</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-annotations</artifactId>
                        <version>4.9.8</version>
                </dependency>
        </dependencies>
        <dependencyManagement>
                <dependencies>
                        <dependency>
                                <groupId>org.opendaylight.yangtools</groupId>
                                <artifactId>yangtools-artifacts</artifactId>
                                <version>14.0.20</version>
                                <type>pom</type>
                                <scope>import</scope>
                        </dependency>
                </dependencies>
        </dependencyManagement>
</project>
