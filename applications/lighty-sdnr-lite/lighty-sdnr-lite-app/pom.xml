<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
        <modelVersion>4.0.0</modelVersion>
        <parent>
        <groupId>io.lighty.core</groupId>
        <artifactId>lighty-app-parent</artifactId>
        <version>23.0.0</version>
        <relativePath/>
    </parent>
        <groupId>org.iosmcn.lighty.sdnr</groupId>
        <artifactId>lighty-sdnr-lite-app</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <packaging>jar</packaging>
        <name>${project.groupId}:${project.artifactId}</name>
        <url>https://github.com/PANTHEONtech/lighty</url>
        <properties>
                <application.main.class>org.iosmcn.lighty.sdnr.lite.app.Main</application.main.class>
                <application.attach.zip>true</application.attach.zip>
                <maven.deploy.skip>true</maven.deploy.skip>
        </properties>

        <dependencies>
                <!-- 
                     O-RAN NETCONF 2013 Support (SELF-CONTAINED - no external netconf repo needed):
                     1. oran-netconf-model: YANG model with ietf-netconf@2013-09-29 revision
                     2. netconf-transformer-patch: Fix for base RPC parsing
                     Both modules compile against Lighty's bundled dependencies.
                -->
                
                <!-- O-RAN NETCONF model with 2013 revision (self-contained) -->
                <dependency>
                        <groupId>org.iosmcn.lighty.sdnr</groupId>
                        <artifactId>oran-netconf-model</artifactId>
                        <version>0.0.1-SNAPSHOT</version>
                </dependency>
                
                <!-- IMPORTANT: netconf-transformer-patch MUST come BEFORE lighty-netconf-sb
                     to ensure the patched NetconfMessageTransformer class takes precedence -->
                <dependency>
                        <groupId>org.iosmcn.lighty.sdnr</groupId>
                        <artifactId>netconf-transformer-patch</artifactId>
                        <version>0.0.1-SNAPSHOT</version>
                </dependency>
                
                <!-- Lighty modules (unchanged - use their bundled netconf 10.0.2) -->
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-netconf-sb</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-restconf-nb-community</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
                        <groupId>io.lighty.modules</groupId>
                        <artifactId>lighty-openapi</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
            <groupId>org.iosmcn.lighty.applications</groupId>
            <artifactId>mountpoint-registrar</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.iosmcn.lighty.sdnr</groupId>
            <artifactId>yang-schema-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.iosmcn.lighty.sdnr</groupId>
            <artifactId>data-provider-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
                <dependency>
                        <groupId>io.lighty.applications</groupId>
                        <artifactId>lighty-app-modules-config</artifactId>
                        <version>23.0.0</version>
                </dependency>
                <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-annotations</artifactId>
                        <version>4.9.8</version>
                </dependency>
        </dependencies>
        <dependencyManagement>
                <dependencies>
                        <dependency>
                                <groupId>org.opendaylight.yangtools</groupId>
                                <artifactId>yangtools-artifacts</artifactId>
                                <version>14.0.20</version>
                                <type>pom</type>
                                <scope>import</scope>
                        </dependency>
                </dependencies>
        </dependencyManagement>
</project>
